# ============================================================
# Generated outputs (regenerated via run_pipeline.py)
# ============================================================
outputs/datasets/*.parquet
outputs/models/*.pkl
outputs/models/*.json
outputs/logs/*.parquet
outputs/experiments/*.json
outputs/figures/*.png
outputs/figures/*.txt
outputs/figures/*.csv
outputs/figures/*.md

# Smoke test temporary output
outputs/figures_smoke/

# Deprecated v1 outputs (kept for reference, not tracked)
outputs/_deprecated_v1/

# Keep directory structure via .gitkeep
!outputs/datasets/.gitkeep
!outputs/models/.gitkeep
!outputs/logs/.gitkeep
!outputs/experiments/.gitkeep
!outputs/figures/.gitkeep

# ============================================================
# FINAL_RESULTS — commit only the evidence files; ignore the
# large regenerable binaries (model, training data)
# ============================================================
FINAL_RESULTS/model/*.pkl
FINAL_RESULTS/training/*.parquet

